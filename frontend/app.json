{
  "expo": {
    "name": "ParkFlow",
    "slug": "parkflow",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ParkFlow to use your location to show nearby parking."
        }
      ],
      "expo-status-bar"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize"
    }
  }
}
